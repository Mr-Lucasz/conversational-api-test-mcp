{
  "name": "conversational-api-test-mcp-video",
  "version": "0.1.0",
  "private": true,
  "description": "Video de divulgacao (LinkedIn, 4:5) do Conversational API Test MCP, feito com Remotion",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "render": "remotion render src/index.ts Promo out/vander-linkedin.mp4",
