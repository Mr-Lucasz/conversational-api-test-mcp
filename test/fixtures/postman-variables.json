{
  "info": {
    "name": "Variables",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [{ "key": "baseUrl", "value": "https://api.example.com/v1/" }],
  "item": [
    {
      "name": "Search",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/comments?postId=1&draft=true",
          "host": ["{{baseUrl}}"],
          "path": ["comments"],
          "query": [
            { "key": "postId", "value": "1" },
            { "key": "draft", "value": "true", "disabled": true }
          ]
        }
      }
    },
    { "name": "Health", "request": { "method": "GET", "url": "{{baseUrl}}/health" } }
  ]
}