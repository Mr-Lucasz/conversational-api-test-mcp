{
  "name": "conversational-api-test-mcp",
  "version": "0.1.0",
  "description": "MCP server — conversational API testing (Configuration as Code in .mcp/api/)",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "api-testing",
    "http",
    "yaml",
    "openapi",
    "postman",
    "insomnia"
  ],
  "license": "MIT",
  "author": "Lucas Rodrigues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mr-Lucasz/conversational-api-test-mcp.git"
  },
  "homepage": "https://github.com/Mr-Lucasz/conversational-api-test-mcp#readme",
  "bugs": {
    "url": "https://github.com/Mr-Lucasz/conversational-api-test-mcp/issues"
  },
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "conversational-api-test-mcp": "./dist/index.js"
  },
  "files": [
    "dist",
    "examples",
    "README.md",
    "README.pt-BR.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "prepublishOnly": "npm run lint && npm test && npm run build"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@toon-format/toon": "^4.1.1",
    "dotenv": "^16.4.0",
    "jsonpath-plus": "^10.0.0",
    "tinyglobby": "^0.2.17",
    "yaml": "^2.5.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^20.0.0",
    "eslint": "^10.12.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.71.1",
    "vitest": "^4.1.11"
  }
}
